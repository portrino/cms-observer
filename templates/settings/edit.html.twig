{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.settings'|trans }} - CMS Observer{% endblock %}

{% block page_title %}{{ 'nav.settings'|trans }}{% endblock %}

{% block body %}
<div class="container" style="max-width: 500px;">
    <h2 class="h4 mb-3">{{ 'calculation.plural'|trans }}</h2>
    <div class="card">
        <div class="card-body">
            <p class="text-muted">{{ 'settings.intro'|trans }}</p>
            {{ form_start(form) }}
                {{ form_row(form.defaultHourlyRate) }}
                {{ form_row(form.defaultManagementPercent) }}
                {{ form_row(form.packagistVendors) }}
                <button type="submit" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('save') }} {{ 'common.save'|trans }}</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
