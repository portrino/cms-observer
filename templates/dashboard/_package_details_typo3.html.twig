{% import 'dashboard/_macros.html.twig' as m %}
{% set links = [
    {url: 'https://extensions.typo3.org/extension/' ~ package.name ~ '/', label: 'TER'},
    {url: details.packagistUrl, label: 'Packagist'},
    {url: details.repositoryUrl, label: 'project.repository'|trans},
    {url: details.manualUrl, label: 'package.manual'|trans},
]|filter(link => link.url) %}
{{ m.package_header(details.description, package.composerName, links) }}
{% if package.matchedAdvisory %}
    {{ m.vulnerability_alert(package.matchedAdvisory.url, package.matchedAdvisory.advisoryId, 'package.known_vulnerability'|trans({severity: package.matchedAdvisory.severity}) ~ '.') }}
{% endif %}
{% if details.newerVersions is empty %}
    <p class="text-muted mb-0">{{ 'package.no_newer'|trans }}</p>
{% else %}
    {% if not details.updateForCore %}{{ m.no_update_for_core(package.site) }}{% endif %}
    <div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead>
            <tr>
                <th>{{ 'common.version'|trans }}</th>
                <th>{{ 'package.comment'|trans }}</th>
                <th>{{ 'common.date'|trans }}</th>
                <th>{{ 'package.compatibility'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for version in details.newerVersions %}
            {% set state = details.versionStates[version.version] %}
            {% set isLatest = version.version == details.latestVersion %}
            <tr class="{{ m.version_row_class(state, isLatest) }}">
                <td class="text-nowrap"><span class="version-number">{{ version.version }}</span>{{ m.version_flag(state.insecure, isLatest) }}
                    {%- if not version.inTer %} <span class="badge text-bg-neutral ms-2" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'package.packagist_only'|trans }}">Packagist</span>{% endif %}</td>
                <td class="text-break">{{ version.uploadComment ?? '—' }}</td>
                <td class="text-nowrap">{{ version.uploadDate ? version.uploadDate|format_date('medium') : '—' }}</td>
                <td class="text-nowrap">
                    {% for major in version.typo3MajorVersions %}
                        {{ m.typo3_major_badge(major, typo3SupportStatus[major] ?? null, loop.last ? '' : 'me-1') }}
                    {% else %}
                        —
                    {% endfor %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
{% endif %}
