{% import 'dashboard/_macros.html.twig' as m %}
{% set wpKind = package.packageType.value == 'wordpress-theme' ? 'themes' : 'plugins' %}
{{ m.package_header(details.wordpressPluginInfo.description ?? null, package.composerName, [
    {url: 'https://wordpress.org/' ~ wpKind ~ '/' ~ package.name ~ '/', label: 'WordPress.org'},
    {url: 'https://' ~ wpKind ~ '.trac.wordpress.org/browser/' ~ package.name ~ '/', label: 'project.repository'|trans},
]) }}
{% set vulnerability = package.matchedWordpressVulnerability %}
{% if vulnerability %}
    {{ m.vulnerability_alert(
        vulnerability.url,
        vulnerability.title,
        'package.known_vulnerability'|trans({severity: vulnerability.cvssRating}) ~ ' (CVSS ' ~ vulnerability.cvssScore ~ ').',
        vulnerability.patchedVersions is empty ? 'package.no_fix'|trans : 'package.fixed_in'|trans({versions: vulnerability.patchedVersions|join(', ')}),
        vulnerability.copyrightNotices,
    ) }}
{% endif %}
{% if details.newerVersions is empty %}
    <p class="text-muted mb-0">{{ 'package.no_newer'|trans }}</p>
{% else %}
    {% if not details.updateForCore %}{{ m.no_update_for_core(package.site) }}{% endif %}
    <div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead>
            <tr>
                <th>{{ 'common.version'|trans }}</th>
                <th>{{ 'package.comment'|trans }}</th>
                <th>{{ 'common.date'|trans }}</th>
                <th>{{ 'package.compatibility'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for version in details.newerVersions %}
            {% set state = details.versionStates[version.version] %}
            {% set isLatest = version.version == details.latestVersion %}
            <tr class="{{ m.version_row_class(state, isLatest) }}">
                <td class="text-nowrap"><span class="version-number">{{ version.version }}</span>{{ m.version_flag(state.insecure, isLatest) }}</td>
                <td>—</td>
                <td class="text-nowrap">{{ version.releaseDate ? version.releaseDate|format_date('medium') : '—' }}</td>
                <td class="text-nowrap">{{ version.requiresWpVersion ? m.wordpress_requires_badge(version.requiresWpVersion, state.compatible) : '—' }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
{% endif %}
