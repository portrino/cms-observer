{# Topbar action: icon-only on phones, where the label would crowd the title #}
{% macro topbar_link(href, iconName, label) %}
    <a href="{{ href }}" class="btn btn-tertiary d-inline-flex align-items-center gap-1" aria-label="{{ label }}">{{ icon(iconName) }}<span class="d-none d-md-inline">{{ label }}</span></a>
{%- endmacro %}

{# Phones only: opens the page's collapsed .page-filters row #}
{% macro filter_toggle(activeCount) %}
    <button type="button" class="btn btn-tertiary d-inline-flex d-md-none align-items-center gap-1" data-bs-toggle="collapse" data-bs-target="#pageFilters" aria-expanded="false" aria-controls="pageFilters" aria-label="{{ 'common.filters'|trans }}">
        {{- icon('filter') -}}
        {%- if activeCount > 0 %}<span class="badge filter-count text-bg-light">{{ activeCount }}</span>{% endif -%}
    </button>
{%- endmacro %}

{# Status badges shrink to icon and version on phones: .badge-text is only
   visually hidden there, screen readers and the tooltip keep the full text. #}
{% macro security_badge(insecure) %}
    {%- import _self as icons -%}
    {%- if insecure is same as(true) -%}
        <span class="badge text-bg-danger ms-2" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.insecure'|trans }}">{{ icons.icon_warning() }}<span class="badge-text">{{ 'badge.insecure'|trans }}</span></span>
    {%- elseif insecure is same as(false) -%}
        <span class="badge text-bg-success ms-2" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.secure'|trans }}">{{ icons.icon_check() }}<span class="badge-text">{{ 'badge.secure'|trans }}</span></span>
    {%- endif -%}
{% endmacro %}

{# Release/version tables (like the TER): only insecure versions get a badge,
   the latest secure one a bold label. #}
{% macro version_flag(insecure, latest) %}
    {%- import _self as icons -%}
    {%- if insecure is same as(true) -%}
        <span class="badge text-bg-danger ms-2" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.insecure'|trans }}">{{ icons.icon_warning() }}<span class="badge-text">{{ 'badge.insecure'|trans }}</span></span>
    {%- elseif latest -%}
        <strong class="ms-2">{{ 'badge.latest'|trans }}</strong>
    {%- endif -%}
{% endmacro %}

{# TYPO3 major a TER version supports, colored by that major's support status (like the TER):
   green regular support, orange ELTS only, gray no support (or unknown). #}
{% macro typo3_major_badge(major, status, class = '') %}
    {%- set styles = {
        supported: ['success', 'badge.typo3.supported'|trans],
        extended: ['warning', 'badge.typo3.elts_only'|trans],
        unsupported: ['neutral', 'badge.typo3.unsupported'|trans],
    } -%}
    {%- set style = styles[status] ?? ['neutral', null] -%}
    <span class="badge text-bg-{{ style[0] }} {{ class }}"
        {%- if style[1] %} data-controller="tooltip" data-bs-toggle="tooltip" title="TYPO3 {{ major }}: {{ style[1] }}"{% endif %}>{{ major }}</span>
{%- endmacro %}

{# Minimum WordPress version of a plugin version, colored by whether the site's WordPress meets it. #}
{% macro wordpress_requires_badge(requires, compatible) %}
    {%- set style = compatible is same as(true) ? ['success', 'badge.wp.compatible'|trans]
        : (compatible is same as(false) ? ['warning', 'badge.wp.needs_newer'|trans] : ['neutral', null]) -%}
    <span class="badge text-bg-{{ style[0] }}"
        {%- if style[1] %} data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.wp.requires'|trans({version: requires}) }}: {{ style[1] }}"{% endif %}>{{ requires }}+</span>
{%- endmacro %}

{# Craft CMS a plugin version requires (its "require" of craftcms/cms), like the WordPress badge:
   a plain "^5.3.0" shows as "5.3+", any other constraint as it is. #}
{% macro craft_requires_badge(constraint, compatible) %}
    {%- set label = constraint matches '/^\\^\\d+\\.\\d+(\\.\\d+)?$/' ? constraint|slice(1)|split('.')|slice(0, 2)|join('.') ~ '+' : constraint -%}
    <span class="badge text-bg-{{ compatible is same as(true) ? 'success' : 'neutral' }}"
        {%- if compatible is same as(true) %} data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.craft.requires'|trans({constraint: constraint}) }}: {{ 'badge.craft.compatible'|trans }}"{% endif %}>{{ label }}</span>
{%- endmacro %}

{# Wordfence/MITRE license terms: their copyright notices (and a link to the record) must accompany the data.
   Rendered inside the vulnerability alert. #}
{% macro vulnerability_copyright(notices) %}
    <p class="small mt-1 mb-0">
        {{ 'badge.vulnerability_data'|trans }}:
        {% for notice in notices -%}
            {{ notice.notice }}{% if notice.licenseUrl %} (<a href="{{ notice.licenseUrl }}" target="_blank" rel="noopener">{{ 'badge.license'|trans }}</a>){% endif %}{% if not loop.last %} · {% endif %}
        {%- endfor %}
    </p>
{% endmacro %}

{% macro outdated_badge(outdated, latestVersion) %}
    {%- import _self as icons -%}
    {%- if outdated is same as(true) -%}
        {%- set text = latestVersion ? 'badge.outdated_available'|trans({version: latestVersion}) : 'badge.outdated'|trans -%}
        <span class="badge text-bg-warning ms-2" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ text }}">{{ icon('arrow-up') }}
            {%- if latestVersion -%}
                <span><span class="badge-text">{{ 'badge.outdated'|trans }} (</span>{{ latestVersion }}<span class="badge-text"> {{ 'badge.available_word'|trans }})</span></span>
            {%- else -%}
                <span class="badge-text">{{ 'badge.outdated'|trans }}</span>
            {%- endif -%}
        </span>
    {%- elseif outdated is same as(false) -%}
        <span class="badge text-bg-success ms-2" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.up_to_date'|trans }}">{{ icons.icon_check() }}<span class="badge-text">{{ 'badge.up_to_date'|trans }}</span></span>
    {%- endif -%}
{% endmacro %}

{# "TYPO3 14 available (14.3.12)", on phones just the version #}
{# "TYPO3 14 compatible version (13.0.0)": an update that needs a newer core, so not "Outdated"; on phones just the version #}
{% macro newer_core_package_badge(typeLabel, coreVersion, packageVersion, class = 'ms-2') %}
    {%- if coreVersion and packageVersion -%}
        {%- set text = 'badge.newer_core_package'|trans({cms: typeLabel ~ ' ' ~ coreVersion, version: packageVersion}) -%}
        <span class="badge text-bg-info {{ class }}" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ text }}">{{ icon('arrow-up') }}<span><span class="badge-text">{{ 'badge.compatible_with'|trans({cms: typeLabel ~ ' ' ~ coreVersion}) }} (</span>{{ packageVersion }}<span class="badge-text">)</span></span></span>
    {%- endif -%}
{%- endmacro %}

{% macro newer_major_badge(typeLabel, release, class = 'ms-2') %}
    {%- set text = 'badge.newer_major'|trans({cms: typeLabel ~ ' ' ~ release.major, version: release.version}) -%}
    <span class="badge text-bg-info {{ class }}" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ text }}">{{ icon('arrow-up') }}<span><span class="badge-text">{{ 'badge.available'|trans({cms: typeLabel ~ ' ' ~ release.major}) }} (</span>{{ release.version }}<span class="badge-text">)</span></span></span>
{%- endmacro %}

{# Compact icon-only badges for the dense site list - text_badge/outdated_badge
   above are for detail-page contexts with room to spell things out. #}

{% macro icon_warning() %}<svg viewBox="0 0 16 16" width="14" height="14"><polygon points="8 2 15 14 1 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><line x1="8" y1="6.5" x2="8" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="12" r="0.8" fill="currentColor"/></svg>{% endmacro %}

{% macro icon_check() %}<svg viewBox="0 0 16 16" width="14" height="14"><polyline points="3 8 6.5 11.5 13 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endmacro %}

{% macro icon_dash() %}<svg viewBox="0 0 16 16" width="14" height="14"><line x1="3" y1="8" x2="13" y2="8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{% endmacro %}

{% macro core_security_icon(insecure) %}
    {%- import _self as icons -%}
    {%- if insecure is same as(true) -%}
        <span class="status-icon text-bg-danger ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.core.insecure'|trans }}">{{ icons.icon_warning() }}</span>
    {%- elseif insecure is same as(false) -%}
        <span class="status-icon text-bg-success ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.core.secure'|trans }}">{{ icons.icon_check() }}</span>
    {%- else -%}
        <span class="status-icon text-bg-neutral ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.core.unknown'|trans }}">{{ icons.icon_dash() }}</span>
    {%- endif -%}
{% endmacro %}

{% macro packages_security_icon(anyInsecure, insecureCount, label) %}
    {%- import _self as icons -%}
    {%- if anyInsecure is same as(true) -%}
        <span class="status-icon text-bg-danger ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.packages.insecure'|trans({label: label, count: insecureCount}) }}">{{ icons.icon_warning() }}</span>
    {%- elseif anyInsecure is same as(false) -%}
        <span class="status-icon text-bg-success ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ label|capitalize }}: {{ 'badge.packages.secure'|trans }}">{{ icons.icon_check() }}</span>
    {%- else -%}
        <span class="status-icon text-bg-neutral ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ label|capitalize }}: {{ 'badge.packages.unknown'|trans }}">{{ icons.icon_dash() }}</span>
    {%- endif -%}
{% endmacro %}

{# PHP and database share one badge and never color the row: on shared hosting they're often out of the maintainers' hands #}
{% macro infrastructure_status_icon(site) %}
    {%- import _self as icons -%}
    {%- set issues = [] -%}
    {%- if site.phpInsecure is same as(true) -%}
        {%- set issues = issues|merge(['badge.infra.php_insecure'|trans({version: site.currentPhpVersion})]) -%}
    {%- elseif site.phpOutdated is same as(true) -%}
        {%- set issues = issues|merge(['badge.infra.php_outdated'|trans({version: site.currentPhpVersion, latest: site.phpLatestVersion ?? 'empty'})]) -%}
    {%- endif -%}
    {%- if site.dbInsecure is same as(true) -%}
        {%- set issues = issues|merge(['badge.infra.db_insecure'|trans({version: site.currentDbVersion})]) -%}
    {%- elseif site.dbOutdated is same as(true) -%}
        {%- set issues = issues|merge(['badge.infra.db_outdated'|trans({version: site.currentDbVersion, latest: site.dbLatestVersion ?? 'empty'})]) -%}
    {%- endif -%}
    {%- if site.runsOutsideProductionContext -%}
        {%- set issues = issues|merge(['badge.infra.context'|trans({context: site.applicationContext})]) -%}
    {%- endif -%}
    {%- if site.phpInsecure is same as(true) or site.dbInsecure is same as(true) or site.runsOutsideProductionContext -%}
        <span class="status-icon text-bg-danger ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ issues|join(', ') }}">{{ icons.icon_warning() }}</span>
    {%- elseif issues is not empty -%}
        <span class="status-icon text-bg-warning ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ issues|join(', ') }}">{{ icons.icon_warning() }}</span>
    {%- elseif site.phpInsecure is not null or site.dbInsecure is not null -%}
        <span class="status-icon text-bg-success ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.infra.ok'|trans }}">{{ icons.icon_check() }}</span>
    {%- else -%}
        <span class="status-icon text-bg-neutral ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.infra.unknown'|trans }}">{{ icons.icon_dash() }}</span>
    {%- endif -%}
{% endmacro %}

{% macro count_badge(count, iconName, title) %}
    <span class="badge badge-count text-bg-neutral ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ title }}">{{ icon(iconName) }}{{ count }}</span>
{% endmacro %}

{% macro package_count_badge(count, label) %}
    {%- import _self as badges -%}
    {{ badges.count_badge(count, 'package', 'badge.installed'|trans({label: label})) }}
{% endmacro %}

{% macro package_updatable_badge(count, label) %}
    {%- if count > 0 -%}
        <span class="badge badge-count text-bg-info ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.updatable'|trans({label: label}) }}">{{ icon('arrow-up') }}{{ count }}</span>
    {%- else -%}
        <span class="badge badge-count text-bg-success ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.no_updates'|trans }}">{{ icon('check') }}{{ count }}</span>
    {%- endif -%}
{% endmacro %}

{% macro stale_badge(lastSeenAt) %}
    {%- import _self as icons -%}
    {%- if lastSeenAt and lastSeenAt < date(constant('App\\Entity\\Site::STALE_AFTER')) -%}
        <span class="status-icon text-bg-warning ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'badge.stale'|trans }}">{{ icons.icon_warning() }}</span>
    {%- endif -%}
{% endmacro %}

{# Links the project's organization, named in the tooltip; a dash without one #}
{% macro organization_icon(organization) %}
    {%- if organization -%}
        <a href="{{ path('dashboard_organization_show', {id: organization.id}) }}" class="cms-type-icon" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ organization.name }}" aria-label="{{ 'organization.label'|trans }}: {{ organization.name }}">{{ icon('building') }}</a>
    {%- else -%}
        <span class="cms-type-icon text-muted" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'organization.none'|trans }}">&mdash;</span>
    {%- endif -%}
{% endmacro %}

{% macro cms_type_icon(type) -%}
    <span class="cms-type-icon" title="{{ type.label }}"><img src="{{ asset(type.icon) }}" alt="{{ type.label }}" width="20" height="20"></span>
{%- endmacro %}

{% macro sla_status_icon(slaActive) %}
    {%- import _self as icons -%}
    {%- if slaActive -%}
        <span class="status-icon text-bg-success ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="SLA: {{ 'badge.sla.active'|trans }}">{{ icons.icon_check() }}</span>
    {%- else -%}
        <span class="status-icon text-bg-neutral ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="SLA: {{ 'badge.sla.inactive'|trans }}">{{ icons.icon_dash() }}</span>
    {%- endif -%}
{% endmacro %}

{# Head of a package's details: description cut to a few lines (the sources have the rest),
   Composer name and source links, the same for every CMS. links: list of {url, label}, official source first. #}
{% macro package_header(description, composerName, links) %}
    {%- if description %}<p class="package-description">{{ description }}</p><hr>{% endif -%}
    {%- if composerName or links is not empty %}
    <dl class="package-meta">
        {%- if composerName %}
        <dt>{{ 'package.composer'|trans }}</dt>
        <dd><code>{{ composerName }}</code></dd>
        {%- endif %}
        {%- if links is not empty %}
        <dt>{{ 'package.links'|trans }}</dt>
        <dd class="package-links">
            {%- for link in links %}
            <a href="{{ link.url }}" target="_blank" rel="noopener" class="d-inline-flex align-items-center gap-1">{{ link.label }} {{ icon('external-link') }}</a>
            {%- endfor %}
        </dd>
        {%- endif %}
    </dl>
    <hr>
    {%- endif %}
{%- endmacro %}

{# Known vulnerability of a package, above its version table: red like the insecure badge and rows.
   summary follows the linked record, note (e.g. the fixed versions) gets its own line. #}
{% macro vulnerability_alert(url, label, summary, note = null, notices = []) %}
    {%- import _self as m -%}
    <div class="alert alert-danger d-flex gap-2 py-2" role="alert">
        <span class="flex-shrink-0">{{ m.icon_warning() }}</span>
        <div>
            <a href="{{ url }}" target="_blank" rel="noopener" class="alert-link d-inline-flex align-items-center gap-1">{{ label }} {{ icon('external-link') }}</a>: {{ summary }}
            {%- if note %}<div>{{ note }}</div>{% endif %}
            {%- if notices is not empty %}{{ m.vulnerability_copyright(notices) }}{% endif %}
        </div>
    </div>
{%- endmacro %}
