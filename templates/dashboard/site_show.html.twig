{% extends 'base.html.twig' %}
{% import 'dashboard/_macros.html.twig' as m %}

{% block title %}{{ site.name }} - CMS Observer{% endblock %}

{% block page_title %}{{ site.name }}{% endblock %}

{% block page_actions %}
    {{ m.topbar_link(path('dashboard_site_history', {id: site.id}), 'history', 'project.history'|trans) }}
    {{ m.topbar_link(path('dashboard_site_edit', {id: site.id}), 'pencil', 'common.edit'|trans) }}
    {% if upgradeCalculations %}
    <div class="dropdown">
        <button type="button" class="btn btn-tertiary" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'common.more_actions'|trans }}">{{ icon('ellipsis-vertical') }}</button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('upgrade_calculation_index', {id: site.id}) }}">{{ icon('calculator') }} {{ 'calculation.plural'|trans }}</a></li>
        </ul>
    </div>
    {% endif %}
{% endblock %}

{% block body %}
<div class="container">
    {% for token in app.flashes('site_token') %}
        <div class="alert alert-warning">
            <strong>{{ 'project.token_shown_once'|trans }}</strong><br>
            <code>{{ token }}</code>
        </div>
    {% endfor %}

    <p class="text-muted fst-italic mb-3">
        {{ 'project.last_seen'|trans }}: {{ site.lastSeenAt ? site.lastSeenAt|format_datetime('medium', 'short') : 'project.never'|trans }}
        {% if site.stale %}
            <span class="badge text-bg-warning ms-2">{{ m.icon_warning() }}{{ 'badge.stale_short'|trans }}</span>
        {% endif %}
    </p>
    {% if site.hasRecentRejectedReport() %}
        <div class="alert alert-warning py-2 mb-3" role="alert">
            {{ 'project.rejected_report'|trans({domains: site.lastRejectedReportDomains|join(', '), date: site.lastRejectedReportAt|format_datetime('medium', 'short'), url: site.url}) }}
        </div>
    {% endif %}

    <div class="row gy-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-white">{{ 'project.system_info'|trans }}</div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <th class="w-25">{{ 'common.type'|trans }}</th>
                                <td><span class="d-inline-flex align-items-center gap-2">{{ m.cms_type_icon(site.type) }}{{ site.type.label }}</span></td>
                            </tr>
                            {% if lastReport %}
                                <tr>
                                    <th>{{ 'project.context'|trans }}</th>
                                    <td>
                                        {{ lastReport.payload.applicationContext ?? '—' }}
                                        {% if site.runsOutsideProductionContext %}
                                            <span class="badge text-bg-danger ms-1" data-controller="tooltip" data-bs-toggle="tooltip" title="{{ 'project.not_production_hint'|trans }}">{{ m.icon_warning() }}<span class="badge-text">{{ 'project.not_production'|trans }}</span></span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>{{ 'project.client_version'|trans }}</th>
                                    <td>{{ lastReport.payload.clientVersion ?? '—' }}</td>
                                </tr>
                                <tr>
                                    <th>{{ 'project.domains'|trans }}</th>
                                    <td>
                                        {% if lastReport.payload.domains ?? [] %}
                                            {{ lastReport.payload.domains|join(', ') }}
                                        {% else %}
                                            <span class="text-muted">{{ 'project.domains_not_reported'|trans }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endif %}
                            <tr>
                                <th>{{ 'project.php_version'|trans }}</th>
                                <td>
                                    {{ site.currentPhpVersion ?? '—' }}
                                    {{ m.security_badge(site.phpInsecure) }}
                                    {{ m.outdated_badge(site.phpOutdated, site.phpLatestVersion) }}
                                    {% if (site.phpInsecure or site.phpOutdated) and site.phpEolUrl %}
                                        <a href="{{ site.phpEolUrl }}" target="_blank" rel="noopener">({{ 'project.eol_info'|trans }})</a>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>{{ 'project.db_version'|trans }}</th>
                                <td>
                                    {% if site.currentDbPlatform %}{{ {mariadb: 'MariaDB', mysql: 'MySQL', postgresql: 'PostgreSQL'}[site.currentDbPlatform] ?? site.currentDbPlatform }} {% endif %}{{ site.currentDbVersion ?? '—' }}
                                    {{ m.security_badge(site.dbInsecure) }}
                                    {{ m.outdated_badge(site.dbOutdated, site.dbLatestVersion) }}
                                    {% if (site.dbInsecure or site.dbOutdated) and site.dbEolUrl %}
                                        <a href="{{ site.dbEolUrl }}" target="_blank" rel="noopener">({{ 'project.eol_info'|trans }})</a>
                                    {% endif %}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-white">{{ 'project.project_info'|trans }}</div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tbody>
                            {% if site.organization %}
                                <tr>
                                    <th class="w-25">{{ 'organization.label'|trans }}</th>
                                    <td><a href="{{ path('dashboard_organization_show', {id: site.organization.id}) }}">{{ site.organization.name }}</a></td>
                                </tr>
                            {% endif %}
                            <tr>
                                <th class="w-25">{{ 'common.website'|trans }}</th>
                                <td class="text-break"><a href="{{ site.url }}" target="_blank" rel="noopener" class="d-inline-flex align-items-center gap-1">{{ site.url }} {{ icon('external-link') }}</a></td>
                            </tr>
                            <tr>
                                <th>{{ 'project.issue_tracker'|trans }}</th>
                                <td class="text-break">
                                {% if site.issueTrackerUrl %}
                                    <a href="{{ site.issueTrackerUrl }}" target="_blank" rel="noopener">{{ site.issueTrackerUrl }}</a>
                                {% else %}
                                    —
                                {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>{{ 'project.repository'|trans }}</th>
                                <td class="text-break">
                                {% if site.repositoryUrl %}
                                    <a href="{{ site.repositoryUrl }}" target="_blank" rel="noopener">{{ site.repositoryUrl }}</a>
                                {% else %}
                                    —
                                {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>SLA</th>
                                <td>{{ m.sla_status_icon(site.slaActive) }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div data-controller="newer-core" data-newer-core-key-value="core">
    {{ m.section_heading('Core', 'coreNewerCore') }}
    <div class="card mb-4">
    <div class="card-body p-0">
    <div class="accordion" id="coreAccordion">
        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#coreAccordionBody" aria-expanded="false" aria-controls="coreAccordionBody">
                    <span class="accordion-title">
                    <span class="me-2 fw-bold">{{ site.currentCoreVersion ?? '—' }}</span>
                    {{ m.security_badge(site.coreInsecure) }}
                    {{ m.outdated_badge(site.coreOutdated, site.coreLatestVersion) }}
                    {% if newerMajorCoreRelease %}
                        {{ m.newer_major_badge(site.type.label, newerMajorCoreRelease, 'badge-next-major') }}
                    {% endif %}
                    </span>
                </button>
            </h3>
            <div id="coreAccordionBody" class="accordion-collapse collapse" data-bs-parent="#coreAccordion">
                <div class="accordion-body">
                {% if newerCoreReleases is empty %}
                    <p class="text-muted mb-0 newer-core-hidden">{{ 'project.no_newer_core'|trans }}</p>
                {% endif %}
                {% if newerCoreReleases is not empty or newerMajorCoreReleases is not empty %}
                    <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>{{ 'common.version'|trans }}</th>
                                <th>{{ 'common.date'|trans }}</th>
                                <th>{{ 'project.notes'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {# newest first, so the first release not known to be insecure is the update target #}
                        {% set latestRelease = newerCoreReleases|filter(r => r.insecure is not same as(true))|first %}
                        {# the newer majors first, as all newest first; behind the section's switch: the upgrade itself #}
                        {% for release in newerMajorCoreReleases %}
                            <tr class="{{ release.insecure ? 'row-insecure' : 'row-secure' }} row-newer-core">
                                <td class="text-nowrap"><span class="version-number">{{ release.version }}</span>{{ m.version_flag(release.insecure, false) }}</td>
                                <td class="text-nowrap">{{ release.releaseDate ? release.releaseDate|format_date('medium') : '—' }}</td>
                                <td><a href="{{ site.type.releaseNotesUrl(release.version) }}" target="_blank" rel="noopener">{{ 'project.release_notes'|trans }}</a></td>
                            </tr>
                        {% endfor %}
                        {% for release in newerCoreReleases %}
                            <tr class="{{ release.insecure ? 'row-insecure' : (release is same as(latestRelease) ? 'row-latest' : 'row-secure') }}">
                                <td class="text-nowrap"><span class="version-number">{{ release.version }}</span>{{ m.version_flag(release.insecure, release is same as(latestRelease)) }}</td>
                                <td class="text-nowrap">{{ release.releaseDate ? release.releaseDate|format_date('medium') : '—' }}</td>
                                <td><a href="{{ site.type.releaseNotesUrl(release.version) }}" target="_blank" rel="noopener">{{ 'project.release_notes'|trans }}</a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% endif %}
                </div>
            </div>
        </div>
    </div>
    </div>
    </div>
    </div>

    <div data-controller="newer-core" data-newer-core-key-value="packages">
    {{ m.section_heading('nav.packages'|trans ~ ' ', 'packagesNewerCore', m.package_count_badge(packages|length, site.type.packagesLabel|trans)) }}
    <div class="card mb-4">
    <div class="card-body p-0">
    <div class="accordion" id="packagesAccordion">
    {% for package in packages %}
        {% set details = packageDetails[package.id] %}
        {% set bodyId = 'packageAccordionBody' ~ package.id %}
        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#{{ bodyId }}" aria-expanded="false" aria-controls="{{ bodyId }}">
                    <span class="accordion-title">
                    <code class="me-2 fw-bold">{{ package.name }}</code>
                    {% if package.packageType.value == 'wordpress-theme' %}<span class="badge text-bg-neutral me-2">Theme</span>{% endif %}
                    <span class="me-2 fw-bold">{{ package.version }}</span>
                    {{ m.security_badge(package.insecure) }}
                    {{ m.outdated_badge(package.outdated, package.latestVersion) }}
                    {% if not package.active %}<span class="badge text-bg-neutral ms-2">{{ 'package.inactive'|trans }}</span>{% endif %}
                    {% if package.matchedAdvisory %}
                        <span class="badge badge-solid text-bg-danger ms-2">{{ m.icon_warning() }}{{ package.matchedAdvisory.advisoryId }} ({{ package.matchedAdvisory.severity }})</span>
                    {% endif %}
                    {% if package.matchedWordpressVulnerability %}
                        <span class="badge badge-solid text-bg-danger ms-2">{{ m.icon_warning() }}{{ package.matchedWordpressVulnerability.cve ?? 'package.vulnerability'|trans }} ({{ package.matchedWordpressVulnerability.cvssRating }})</span>
                    {% endif %}
                    {{ m.newer_core_package_badge(site.type.label, package.newerCoreVersion, package.newerCorePackageVersion, 'badge-next-major') }}
                    </span>
                </button>
            </h3>
            <div id="{{ bodyId }}" class="accordion-collapse collapse" data-bs-parent="#packagesAccordion">
                <div class="accordion-body">
                {{ include('dashboard/_package_details_' ~ site.type.value ~ '.html.twig') }}
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-muted">{{ 'package.none_reported'|trans }}</p>
    {% endfor %}
    </div>
    </div>
    </div>
    </div>
</div>
{% endblock %}
