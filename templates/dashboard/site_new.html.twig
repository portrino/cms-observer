{% extends 'base.html.twig' %}
{% import 'dashboard/_macros.html.twig' as m %}

{% block title %}{{ 'project.add'|trans }} - CMS Observer{% endblock %}

{% block page_title %}{{ 'project.add'|trans }}{% endblock %}

{% block page_actions %}
    {{ m.topbar_link(path('dashboard_index'), 'arrow-left', 'project.all'|trans) }}
{% endblock %}

{% block body %}
<div class="container" style="max-width: 500px;">
    <div class="card">
        <div class="card-body">
            {{ form_start(form, {attr: {'data-controller': 'organization-select', 'data-action': 'submit->organization-select#submit'}}) }}
                {{ form_row(form.name) }}
                {{ form_row(form.url) }}
                {{ form_row(form.type) }}
                {{ form_row(form.slaActive) }}
                {{ form_row(form.organization, {attr: {'data-organization-select-target': 'select', 'data-action': 'organization-select#toggle'}}) }}
                <div data-organization-select-target="newField">
                    {{ form_row(form.newOrganization, {attr: {'data-organization-select-target': 'newInput'}}) }}
                </div>
                {{ form_row(form.repositoryUrl) }}
                {{ form_row(form.issueTrackerUrl) }}
                <button type="submit" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('plus') }} {{ 'common.create'|trans }}</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
