{% extends 'base.html.twig' %}
{% import 'dashboard/_macros.html.twig' as m %}

{% block title %}Edit {{ site.name }} - CMS Observer{% endblock %}

{% block page_title %}Edit Project{% endblock %}

{% block page_actions %}
    {{ m.topbar_link(path('dashboard_site_show', {id: site.id}), 'arrow-left', 'Back to project') }}
{% endblock %}

{% block body %}
{% set confirmationString = site.organization ? site.organization.name ~ '/' ~ site.name : site.name %}
<div class="container" style="max-width: 500px;">
    <div class="card">
        <div class="card-body">
            {{ form_start(form, {attr: {id: 'site-edit-form', 'data-controller': 'organization-select', 'data-action': 'submit->organization-select#submit'}}) }}
                {{ form_row(form.name) }}
                {{ form_row(form.url) }}
                {{ form_row(form.type) }}
                {{ form_row(form.slaActive) }}
                {{ form_row(form.organization, {attr: {'data-organization-select-target': 'select', 'data-action': 'organization-select#toggle'}}) }}
                <div data-organization-select-target="newField">
                    {{ form_row(form.newOrganization, {attr: {'data-organization-select-target': 'newInput'}}) }}
                </div>
                {{ form_row(form.repositoryUrl) }}
                {{ form_row(form.issueTrackerUrl) }}
            {{ form_end(form) }}
        </div>
        <div class="card-footer bg-white d-flex justify-content-between">
            <button type="submit" form="site-edit-form" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('save') }} Save</button>
            <button type="button" class="btn btn-outline-danger d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#deleteSiteModal">
                {{ icon('trash') }} Delete project
            </button>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <h2 class="h6">Push token</h2>
            <p class="text-muted mb-0">The token is stored hashed and can't be shown again. If it got lost, generate a new one.</p>
        </div>
        <div class="card-footer bg-white">
            <button type="button" class="btn btn-outline-danger d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#regenerateTokenModal">
                {{ icon('key-round') }} Generate new token
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="regenerateTokenModal" tabindex="-1" aria-labelledby="regenerateTokenModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('dashboard_site_regenerate_token', {id: site.id}) }}">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="regenerateTokenModalLabel">Generate a new push token</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-0">
                        The current token stops working immediately. The site's reports are rejected
                        until the new token is entered in its client.
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('regenerate-token-' ~ site.id) }}">
                </div>
                <div class="modal-footer justify-content-start">
                    <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-1">
                        {{ icon('key-round') }} Generate new token
                    </button>
                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteSiteModal" tabindex="-1" aria-labelledby="deleteSiteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('dashboard_site_delete', {id: site.id}) }}"
                  data-controller="delete-confirmation" data-expected="{{ confirmationString }}">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="deleteSiteModalLabel">Delete this project</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            <li>This operation <strong>CANNOT</strong> be undone.</li>
                            <li>This operation will permanently delete the <strong>{{ confirmationString }}</strong> project including all referenced data.</li>
                        </ul>
                    </div>
                    <p>Enter the organization and project name exactly as shown: <code>{{ confirmationString }}</code></p>
                    <div class="mb-0">
                        <label for="deleteSiteConfirmationInput" class="form-label">Confirmation string</label>
                        <input type="text" id="deleteSiteConfirmationInput" name="confirmation" class="form-control" required
                               autocomplete="off" data-delete-confirmation-target="input" data-action="input->delete-confirmation#check">
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-site-' ~ site.id) }}">
                </div>
                <div class="modal-footer justify-content-start">
                    <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-1" disabled data-delete-confirmation-target="submit">
                        {{ icon('trash') }} Delete project
                    </button>
                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
