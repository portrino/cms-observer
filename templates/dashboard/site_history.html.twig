{% extends 'base.html.twig' %}

{% block title %}{{ 'project.history_of'|trans({name: site.name}) }} - CMS Observer{% endblock %}

{% import 'dashboard/_macros.html.twig' as m %}

{% block page_title %}{{ 'project.history_of'|trans({name: site.name}) }}{% endblock %}

{% block page_actions %}
    {{ m.filter_toggle([query, type]|filter(v => v)|length) }}
    {{ m.topbar_link(path('dashboard_site_show', {id: site.id}), 'arrow-left', 'project.back'|trans) }}
{% endblock %}

{% block body %}
<div class="container">
    <div class="page-filters collapse d-md-block" id="pageFilters">
    <form method="get" class="row g-2 mb-3" data-controller="auto-submit" data-turbo-frame="history-results">
        <div class="col-auto">
            <input type="search" name="q" value="{{ query }}" class="form-control" placeholder="{{ 'history.search'|trans }}" aria-label="{{ 'common.search'|trans }}" data-action="input->auto-submit#submitAfterTyping">
        </div>
        <div class="col-auto">
            <select name="type" class="form-select" aria-label="{{ 'history.type'|trans }}" data-action="change->auto-submit#submit">
                <option value="">{{ 'history.all'|trans }}</option>
                {% for eventType in eventTypes %}
                    <option value="{{ eventType.value }}" {{ eventType == type ? 'selected' }}>{{ eventType|trans }}</option>
                {% endfor %}
            </select>
        </div>
        <noscript class="col-auto">
            <button type="submit" class="btn btn-tertiary">{{ 'common.filter'|trans }}</button>
        </noscript>
    </form>
    </div>

    {# filters and page links only swap this frame; "advance" keeps the URL (and back button) in sync #}
    <turbo-frame id="history-results" data-turbo-action="advance">
    {% if events|length == 0 %}
        <p class="text-muted">{{ (query or type ? 'history.none_filtered' : 'history.none')|trans }}</p>
    {% else %}
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0" id="siteHistory">
                    <thead>
                        <tr>
                            <th class="w-auto text-nowrap">{{ 'common.date'|trans }}</th>
                            <th>{{ 'history.change'|trans }}</th>
                            <th>{{ 'history.details'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in events %}
                            <tr>
                                <td class="text-nowrap">{{ event.occurredAt|format_datetime('medium', 'short') }}</td>
                                <td class="text-nowrap">
                                    {% if event.type.value == 'became-insecure' %}
                                        <span class="badge text-bg-danger">{{ event.type|trans }}</span>
                                    {% elseif event.type.value == 'became-secure' %}
                                        <span class="badge text-bg-success">{{ event.type|trans }}</span>
                                    {% elseif event.type.value in ['report-rejected', 'stopped-reporting'] %}
                                        <span class="badge text-bg-warning">{{ event.type|trans }}</span>
                                    {% else %}
                                        {{ event.type|trans }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if event.subject %}<code>{{ event.subjectMessage|trans }}</code>{% endif %}
                                    {% if event.oldValue and event.newValue %}
                                        {{ event.oldValue }} &rarr; {{ event.newValue }}
                                    {% else %}
                                        {{ event.oldValue ?? event.newValue }}
                                    {% endif %}
                                    {% if event.type.value == 'report-rejected' %}
                                        {{ 'history.from'|trans({detail: event.detail}) }}
                                    {% elseif event.detail %}
                                        <span class="text-muted">{{ event.detailMessage|trans }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if pageCount > 1 %}
            <nav class="mt-3" aria-label="{{ 'history.pages'|trans }}">
                <ul class="pagination">
                    {% for p in 1..pageCount %}
                        <li class="page-item {{ p == page ? 'active' }}">
                            <a class="page-link" href="{{ path('dashboard_site_history', {id: site.id, q: query, type: type ? type.value : null, page: p}) }}"{% if p == page %} aria-current="page"{% endif %}>{{ p }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    {% endif %}
    </turbo-frame>
</div>
{% endblock %}
