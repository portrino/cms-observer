{% extends 'base.html.twig' %}

{% block title %}History of {{ site.name }} - CMS Observer{% endblock %}

{% import 'dashboard/_macros.html.twig' as m %}

{% block page_title %}History of {{ site.name }}{% endblock %}

{% block page_actions %}
    {{ m.filter_toggle([query, type]|filter(v => v)|length) }}
    {{ m.topbar_link(path('dashboard_site_show', {id: site.id}), 'arrow-left', 'Back to project') }}
{% endblock %}

{% block body %}
<div class="container">
    <div class="page-filters collapse d-md-block" id="pageFilters">
    <form method="get" class="row g-2 mb-3" data-controller="auto-submit" data-turbo-frame="history-results">
        <div class="col-auto">
            <input type="search" name="q" value="{{ query }}" class="form-control" placeholder="Search package, version…" aria-label="Search" data-action="input->auto-submit#submitAfterTyping">
        </div>
        <div class="col-auto">
            <select name="type" class="form-select" aria-label="Type of change" data-action="change->auto-submit#submit">
                <option value="">All changes</option>
                {% for eventType in eventTypes %}
                    <option value="{{ eventType.value }}" {{ eventType == type ? 'selected' }}>{{ eventType.label }}</option>
                {% endfor %}
            </select>
        </div>
        <noscript class="col-auto">
            <button type="submit" class="btn btn-tertiary">Filter</button>
        </noscript>
    </form>
    </div>

    {# filters and page links only swap this frame; "advance" keeps the URL (and back button) in sync #}
    <turbo-frame id="history-results" data-turbo-action="advance">
    {% if events|length == 0 %}
        <p class="text-muted">No changes recorded{{ query or type ? ' for this filter' }}.</p>
    {% else %}
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0" id="siteHistory">
                    <thead>
                        <tr>
                            <th class="w-auto text-nowrap">Date</th>
                            <th>Change</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in events %}
                            <tr>
                                <td class="text-nowrap">{{ event.occurredAt|date('Y-m-d H:i') }}</td>
                                <td class="text-nowrap">
                                    {% if event.type.value == 'became-insecure' %}
                                        <span class="badge text-bg-danger">{{ event.type.label }}</span>
                                    {% elseif event.type.value in ['report-rejected', 'stopped-reporting'] %}
                                        <span class="badge text-bg-warning">{{ event.type.label }}</span>
                                    {% else %}
                                        {{ event.type.label }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if event.subject %}<code>{{ event.subject }}</code>{% endif %}
                                    {% if event.oldValue and event.newValue %}
                                        {{ event.oldValue }} &rarr; {{ event.newValue }}
                                    {% else %}
                                        {{ event.oldValue ?? event.newValue }}
                                    {% endif %}
                                    {% if event.type.value == 'report-rejected' %}
                                        from {{ event.detail }}
                                    {% elseif event.detail %}
                                        <span class="text-muted">{{ event.detail }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if pageCount > 1 %}
            <nav class="mt-3" aria-label="History pages">
                <ul class="pagination">
                    {% for p in 1..pageCount %}
                        <li class="page-item {{ p == page ? 'active' }}">
                            <a class="page-link" href="{{ path('dashboard_site_history', {id: site.id, q: query, type: type ? type.value : null, page: p}) }}"{% if p == page %} aria-current="page"{% endif %}>{{ p }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    {% endif %}
    </turbo-frame>
</div>
{% endblock %}
