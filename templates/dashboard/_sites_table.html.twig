{% import 'dashboard/_macros.html.twig' as m %}
{% set emptyMessage = emptyMessage|default('No projects registered yet.') %}
{# off on an organization's own page, where every project belongs to it #}
{% set showOrganization = showOrganization ?? true %}

<table class="table table-hover align-middle bg-white">
    <thead>
        <tr>
            <th>Name</th>
            {% if showOrganization %}<th>Org</th>{% endif %}
            <th>Type</th>
            <th>Core</th>
            <th>Packages</th>
            <th>Security</th>
            <th>SLA</th>
        </tr>
    </thead>
    <tbody>
    {% for site in sites %}
        {% set packageStatus = packageStatusBySite[site.id] ?? {insecure: null, outdated: null} %}
        {% set packageSummary = packageSummaryBySite[site.id] ?? {total: 0, updatable: 0, insecureCount: 0} %}
        {% set coreStatus = coreMajorStatusBySite[site.id] ?? {outdated: null, latestInMajor: null, newerMajor: null} %}
        {% set packageLabel = site.type.value == 'typo3' ? 'extensions' : 'plugins and themes' %}
        {% set anyInsecure = site.coreInsecure is same as(true) or packageStatus.insecure is same as(true) %}
        <tr class="{{ anyInsecure ? 'row-insecure' : '' }}">
            <td class="text-nowrap">
                <small class="fw-bold">
                    <a href="{{ path('dashboard_site_show', {id: site.id}) }}">{{ site.name }}</a>
                </small>
                {{ m.stale_badge(site.lastSeenAt) }}
            </td>
            {% if showOrganization %}
                <td>{{ m.organization_icon(site.organization) }}</td>
            {% endif %}
            <td>{{ m.cms_type_icon(site.type) }}</td>
            <td class="text-nowrap">
                <small class="fw-bold">{{ site.currentCoreVersion ?? '—' }}</small>
                {{ m.outdated_badge(coreStatus.outdated, coreStatus.latestInMajor) }}
                {% if coreStatus.newerMajor %}
                    {{ m.newer_major_badge(site.type.label, coreStatus.newerMajor, 'ms-1') }}
                {% endif %}
            </td>
            <td class="text-nowrap">
                {{ m.package_count_badge(packageSummary.total, packageLabel) }}
                {{ m.package_updatable_badge(packageSummary.updatable, packageLabel) }}
            </td>
            <td class="text-nowrap">
                {{ m.core_security_icon(site.coreInsecure) }}
                {{ m.packages_security_icon(packageStatus.insecure, packageSummary.insecureCount, packageLabel) }}
                {{ m.infrastructure_status_icon(site) }}
            </td>
            <td>{{ m.sla_status_icon(site.slaActive) }}</td>
        </tr>
    {% else %}
        <tr><td colspan="{{ showOrganization ? 7 : 6 }}">{{ emptyMessage }}</td></tr>
    {% endfor %}
    </tbody>
</table>
