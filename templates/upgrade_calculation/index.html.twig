{% extends 'base.html.twig' %}
{% import 'dashboard/_macros.html.twig' as m %}

{% block title %}{{ 'calculation.of'|trans({name: site.name}) }} - CMS Observer{% endblock %}

{% block page_title %}{{ 'calculation.of'|trans({name: site.name}) }}{% endblock %}

{% block page_actions %}
    {{ m.topbar_link(path('dashboard_site_show', {id: site.id}), 'arrow-left', 'project.back'|trans) }}
{% endblock %}

{% block body %}
<div class="container">
    <div class="card mb-3">
        <div class="card-body">
            {% if targetMajors is empty %}
                <p class="text-muted mb-0">{{ (site.currentCoreVersion ? 'calculation.no_newer_major' : 'calculation.no_newer_major_unreported')|trans({cms: site.type.label}) }}</p>
            {% else %}
                <form method="get" action="{{ path('upgrade_calculation_new', {id: site.id}) }}" class="row g-2 align-items-center">
                    <label class="col-auto" for="target">{{ 'calculation.new_from'|trans({from: site.type.label ~ ' ' ~ site.currentCoreVersion}) }}</label>
                    <div class="col-auto">
                        <select name="target" id="target" class="form-select">
                            {% for major in targetMajors %}
                                <option value="{{ major }}">{{ site.type.label }} {{ major }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('plus') }} {{ 'calculation.start'|trans }}</button>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>

    {% if calculations is empty %}
        <p class="text-muted">{{ 'calculation.none_yet'|trans }}</p>
    {% else %}
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0" id="upgradeCalculations">
                    <thead>
                        <tr>
                            <th>Upgrade</th>
                            <th>{{ 'calculation.last_saved'|trans }}</th>
                            <th>{{ 'calculation.by'|trans }}</th>
                            <th>{{ 'calculation.versions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for calculation in calculations %}
                            {% set latest = calculation.latestVersion %}
                            <tr>
                                <td><a href="{{ path('upgrade_calculation_show', {id: calculation.id}) }}">{{ site.type.label }} {{ calculation.fromMajor }} → {{ calculation.targetMajor }}</a>
                                    {% if latest.final %}<span class="badge text-bg-success">{{ 'calculation.final'|trans }}</span>{% endif %}</td>
                                <td class="text-nowrap">{{ latest.createdAt|format_datetime('medium', 'short') }}</td>
                                <td>{{ latest.author }}</td>
                                <td>{{ m.count_badge(calculation.versions|length, 'receipt-text', 'calculation.saved_versions'|trans) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
