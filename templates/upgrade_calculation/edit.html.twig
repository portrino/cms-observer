{% extends 'base.html.twig' %}
{% import 'dashboard/_macros.html.twig' as m %}
{% import 'upgrade_calculation/_macros.html.twig' as u %}

{% block title %}{{ title }} - {{ site.name }} - CMS Observer{% endblock %}

{% block page_title %}{{ title }}{% endblock %}

{% block page_actions %}
    {{ m.topbar_link(cancelUrl, 'arrow-left', 'Cancel') }}
{% endblock %}

{% block body %}
<div class="container-fluid">
    {% if based_on is defined %}
        <p class="text-muted">Based on the version of {{ based_on.createdAt|date('Y-m-d H:i') }} by {{ based_on.author }}. Saving creates a new version, this one stays as it is.</p>
    {% endif %}

    {{ form_start(form, {attr: {id: 'upgrade-calculation-form'}}) }}
        {{ form_errors(form) }}
        {% for section in ['positions', 'packages', 'own-packages', 'optional'] %}
            {% set collection = form[section] %}
            {% set package = section in ['packages', 'own-packages'] %}
            <div class="card mb-3" data-controller="form-collection" data-form-collection-index-value="{{ collection|length > 0 ? max(collection|keys) + 1 : 0 }}">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0">{{ collection.vars.label }}</h2>
                    <button type="button" class="btn btn-sm btn-tertiary d-inline-flex align-items-center gap-1" data-action="form-collection#add">{{ icon('plus') }} Add row</button>
                </div>
                <div class="card-body p-0 table-responsive">
                    <table class="table table-sm mb-0 upgrade-table" id="upgrade-{{ section }}">
                        <thead>
                            <tr>
                                <th>{{ package ? 'Package' : 'Position' }}</th>
                                {% if package %}<th>Installed</th><th>Target</th><th>To-do</th>{% endif %}
                                <th>Min h</th>
                                <th>Max h</th>
                                <th>Notes</th>
                                <th>By</th>
                                <th class="upgrade-col-actions"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody data-form-collection-target="rows">
                            {% for entry in collection %}
                                {{ u.form_row(entry, package) }}
                            {% endfor %}
                        </tbody>
                    </table>
                    <template data-form-collection-target="prototype">{{ u.form_row(collection.vars.prototype, package) }}</template>
                </div>
            </div>
            {% do collection.setRendered %}
        {% endfor %}

        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">{{ form_row(form.hourlyRate) }}</div>
                    <div class="col-md-3">{{ form_row(form.managementPercent) }}</div>
                    <div class="col-md-6">{{ form_row(form.remarks) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-3">{{ form_row(form.author) }}</div>
                    <div class="col-md-6">{{ form_row(form.note) }}</div>
                    <div class="col-md-3 pt-md-4">{{ form_row(form.final) }}</div>
                </div>
                <button type="submit" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('save') }} Save as new version</button>
            </div>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
