{% extends 'base.html.twig' %}
{% import 'dashboard/_macros.html.twig' as m %}
{% import 'upgrade_calculation/_macros.html.twig' as u %}

{% set upgrade = site.type.label ~ ' ' ~ calculation.fromMajor ~ ' → ' ~ calculation.targetMajor %}

{% block title %}{{ upgrade }} - {{ site.name }} - CMS Observer{% endblock %}

{% block page_title %}Upgrade {{ upgrade }} <span class="topbar-subtitle">{{ site.name }}</span>{% endblock %}

{% block page_actions %}
    {{ m.topbar_link(path('upgrade_calculation_index', {id: site.id}), 'arrow-left', 'All calculations') }}
    <button type="button" class="btn btn-tertiary d-inline-flex align-items-center gap-1" data-controller="print" data-action="print#print" aria-label="Print or save as PDF">{{ icon('printer') }}<span class="d-none d-md-inline">Print / PDF</span></button>
    {{ m.topbar_link(path('upgrade_calculation_refresh', {id: calculation.id, version: version.id}), 'refresh-cw', 'Refresh from report') }}
    {{ m.topbar_link(path('upgrade_calculation_edit', {id: calculation.id, version: version.id}), 'pencil', 'Edit') }}
{% endblock %}

{% block body %}
{% set rate = version.hourlyRate %}
<div class="container-fluid upgrade-calculation">
    <div class="row">
        <div class="col-lg-9">
            <div class="card mb-3">
                <div class="card-body">
                    {# printed: title and project instead of this version, which the changelog below lists #}
                    <h2 class="h5 print-only">Upgrade {{ upgrade }}</h2>
                    <p class="print-only mb-0" id="upgradeProject">Project: {{ site.organization ? site.organization.name ~ ' / ' }}{{ site.name }} ({{ site.url }})</p>
                    <p class="mb-1 no-print">
                        Version of {{ version.createdAt|date('Y-m-d H:i') }} by {{ version.author }}
                        {% if version.final %}<span class="badge text-bg-success">Final</span>{% endif %}
                        {% if version != calculation.latestVersion %}<span class="badge text-bg-warning no-print">Older version</span>{% endif %}
                    </p>
                    {% if version.note %}<p class="text-muted mb-0 no-print">{{ version.note|nl2br }}</p>{% endif %}
                    {# the changelog head of the printed calculation: this version and all before it #}
                    <table class="table table-sm mb-0 mt-3 print-only" id="upgradeChangelog">
                        <thead><tr><th>Date</th><th>By</th><th>Change</th></tr></thead>
                        <tbody>
                            {% for other in calculation.versions|reverse|filter(other => other.createdAt <= version.createdAt) %}
                                <tr><td class="text-nowrap">{{ other.createdAt|date('Y-m-d H:i') }}</td><td>{{ other.author }}</td><td>{{ other.note }}{% if other.final %} <span class="badge text-bg-success">Final</span>{% endif %}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% if version.headerNotes %}<div class="upgrade-markdown mt-3" id="upgradeHeaderNotes">{{ version.headerNotes|markdown_to_html }}</div>{% endif %}
                </div>
            </div>

            {% if supportPhases is not empty %}
                <div class="card mb-3" id="upgradeTimeline">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">Timeline</h2></div>
                    <div class="card-body">
                        {% if supportPhases is not empty %}
                            {{ u.support_text(site.type.label, supportPhases, calculation.fromMajor) }}
                            <div class="my-3">{{ u.support_chart(site.type.label, supportChart) }}</div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {% for section in sections %}
                {% set items = version.items(section) %}
                {% if items is not empty %}
                    {% set package = section.hasPackages %}
                    {# positions are the Excel template's summary: with the package sections as their sums, and prices #}
                    {% set summary = section.value == 'positions' %}
                    <div class="card mb-3">
                        <div class="card-header bg-white"><h2 class="h6 mb-0">{{ section.label }}</h2></div>
                        <div class="card-body p-0 table-responsive">
                            <table class="table table-sm mb-0 upgrade-table" id="upgrade-{{ section.value }}">
                                <thead>
                                    <tr>
                                        <th>{{ package ? 'Package' : 'Position' }}</th>
                                        {% if package %}<th>Installed</th><th>Target</th><th>To-do</th>{% endif %}
                                        <th class="text-end">Hours</th>
                                        {% if summary %}<th class="text-end">Price</th>{% endif %}
                                        <th>Notes</th>
                                        {# who does it: internal planning, not for the customer #}
                                        <th class="no-print">By</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in items %}
                                        {% set sum = item.sumOf ? totals.sections[item.sumOf.value] : null %}
                                        <tr {% if sum %}class="upgrade-sum-row"{% endif %}>
                                            <td>{{ item.label }}</td>
                                            {% if package %}
                                                <td><code>{{ item.installedVersion }}</code></td>
                                                <td class="{{ item.status and item.status.value == 'update-first' ? 'table-info' }}"><code>{{ item.targetVersion }}</code></td>
                                                <td>{% if item.status %}<span class="badge text-bg-{{ item.status.color }}">{{ item.status.label }}</span>{% endif %}</td>
                                            {% endif %}
                                            <td class="text-end text-nowrap">{{ sum ? u.row_hours(sum.min, sum.max) : u.row_hours(item.minHours, item.maxHours) }}</td>
                                            {% if summary %}<td class="text-end text-nowrap">{{ sum or item.maxHours is not null or item.minHours is not null ? u.price({max: sum ? sum.max : (item.maxHours ?? item.minHours)}, rate) }}</td>{% endif %}
                                            <td class="upgrade-notes upgrade-markdown {{ item.noteLevel ? 'table-' ~ item.noteLevel.value }}">{{ item.notes ? item.notes|markdown_to_html }}</td>
                                            <td class="no-print">{{ item.assignee }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                                <tfoot>
                                    {% set sectionSum = summary ? totals.work : totals.sections[section.value] %}
                                    <tr><th colspan="{{ package ? 4 : 1 }}">Sum</th><th class="text-end text-nowrap">{{ u.hours(sectionSum) }}</th>{% if summary %}<th class="text-end text-nowrap">{{ u.price(sectionSum, rate) }}</th>{% endif %}<th></th><th class="no-print"></th></tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}

            <div class="card mb-3">
                <div class="card-body p-0">
                    <table class="table mb-0" id="upgradeTotals">
                        <thead>
                            <tr><th></th><th class="text-end">Hours</th><th class="text-end">Price ({{ rate|number_format(2, ',', '.') }} EUR/h)</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Positions</td><td class="text-end text-nowrap">{{ u.hours(totals.work) }}</td><td class="text-end text-nowrap">{{ u.price(totals.work, rate) }}</td></tr>
                            <tr><td>Project management ({{ version.managementPercent }} %)</td><td class="text-end text-nowrap">{{ u.hours(totals.requiredManagement) }}</td><td class="text-end text-nowrap">{{ u.price(totals.requiredManagement, rate) }}</td></tr>
                            <tr class="fw-bold"><td>Total</td><td class="text-end text-nowrap">{{ u.hours(totals.required) }}</td><td class="text-end text-nowrap">{{ u.price(totals.required, rate) }}</td></tr>
                            {% if totals.beforehand.max > 0 %}
                                <tr class="text-muted" id="upgradeBeforehand"><td>of which possible before the upgrade, e.g. in maintenance</td><td class="text-end text-nowrap">{{ u.hours(totals.beforehand) }}</td><td class="text-end text-nowrap">{{ u.price(totals.beforehand, rate) }}</td></tr>
                            {% endif %}
                            {% if totals.optional.max > 0 %}
                                <tr><td>Optional, incl. project management</td><td class="text-end text-nowrap">{{ u.hours(totals.optional) }}</td><td class="text-end text-nowrap">{{ u.price(totals.optional, rate) }}</td></tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
                {% if version.remarks %}<div class="card-footer bg-white text-muted upgrade-markdown">{{ version.remarks|markdown_to_html }}</div>{% endif %}
            </div>
        </div>

        <div class="col-lg-3 no-print">
            <div class="card">
                <div class="card-header bg-white"><h2 class="h6 mb-0">Versions</h2></div>
                <ul class="list-group list-group-flush" id="upgradeVersions">
                    {% for other in calculation.versions %}
                        <a href="{{ path('upgrade_calculation_show', {id: calculation.id, version: other.id}) }}" class="list-group-item list-group-item-action {{ other == version ? 'active' }}">
                            <div class="d-flex justify-content-between">
                                <span>{{ other.createdAt|date('Y-m-d H:i') }}</span>
                                {% if other.final %}<span class="badge text-bg-success">Final</span>{% endif %}
                            </div>
                            <div class="small">{{ other.author }}</div>
                            {% if other.note %}<div class="small text-truncate">{{ other.note }}</div>{% endif %}
                        </a>
                    {% endfor %}
                </ul>
                {% if version != calculation.versions|last %}
                    <div class="card-footer bg-white">
                        <a href="{{ path('upgrade_calculation_compare', {id: calculation.id, to: version.id}) }}" class="d-inline-flex align-items-center gap-1">{{ icon('history') }} Compare with previous</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
