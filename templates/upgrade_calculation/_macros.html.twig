{# Sums and prices are calculated with the maximum effort, like the agency always did #}
{% macro hours(range) -%}
    {{ range.max|format_number({fraction_digit: 2}) }} h
{%- endmacro %}

{% macro price(range, rate) -%}
    {{ (range.max * rate)|format_currency('EUR') }}
{%- endmacro %}

{# A row's effort: the range on screen, as a hint that it was hard to estimate; printed only the maximum #}
{% macro row_hours(min, max) -%}
    {%- if min is not null or max is not null -%}
        {%- set max = max ?? min -%}
        {%- set min = min ?? max -%}
        {%- if min != max -%}
            <span class="no-print">{{ min|format_number({fraction_digit: 2}) }}–{{ max|format_number({fraction_digit: 2}) }} h</span><span class="print-only">{{ max|format_number({fraction_digit: 2}) }} h</span>
        {%- else -%}
            {{ max|format_number({fraction_digit: 2}) }} h
        {%- endif -%}
    {%- endif -%}
{%- endmacro %}

{# The first line of a row's notes in its color; opens the note dialog #}
{% macro note_preview(text, level) %}
    {# first line without Markdown marks, like note_editor_controller.js #}
    {% set firstLine = ((text ?? '')|split("\n")|map(line => line|trim)|filter(line => line)|first ?: '')|markdown_to_html|striptags|trim %}
    <button type="button" class="btn btn-sm upgrade-note {{ level ? 'upgrade-note-' ~ level }} {{ firstLine ? '' : 'upgrade-note-empty' }}" data-action="note-editor#open" data-note-field="preview" data-empty-text="{{ 'calculation.add_note'|trans }}" aria-label="{{ 'calculation.edit_notes'|trans }}">
        <span class="upgrade-note-text">{{ firstLine ?: 'calculation.add_note'|trans }}</span>
    </button>
{% endmacro %}

{# One editable row of a calculation form; also renders the prototype for new rows #}
{% macro form_row(entry, package, previousItems = []) %}
    {% set sm = {attr: {class: 'form-control form-control-sm'}} %}
    {# a position standing for a package section: label and hours come from that section, it can't be removed #}
    {% set sumOf = entry.sumOf is defined ? entry.sumOf.vars.value : null %}
    {# a row a refresh added or changed: someone checks it before saving; its previous version, if it had one #}
    {% set changed = '1' == entry.review.vars.value %}
    {% set previous = changed and package ? previousItems[(entry.packageType.vars.value ?? '') ~ '|' ~ entry.package.vars.value] ?? null : null %}
    <tr data-form-collection-row class="{{ [sumOf ? 'upgrade-sum-row', changed ? 'upgrade-changed-row']|filter(c => c)|join(' ') }}">
        <td class="upgrade-col-handle">
            <button type="button" class="btn btn-sm upgrade-handle" aria-label="{{ 'calculation.move_row'|trans }}"
                    data-action="pointerdown->form-collection#grab keydown->form-collection#key">{{ icon('grip-vertical') }}</button>
            {{ form_widget(entry.position, {attr: {'data-form-collection-target': 'position'}}) }}
            {{ form_widget(entry.sumOf) }}
            {{ form_widget(entry.preset) }}
            {{ form_widget(entry.review) }}
        </td>
        <td class="upgrade-col-label">
            {% if sumOf %}
                {{ form_widget(entry.label, {value: enum('App\\Entity\\UpgradeSection').from(sumOf)|trans, attr: {class: 'form-control-plaintext form-control-sm fw-semibold', readonly: 'readonly', tabindex: '-1'}}) }}
            {% else %}
                {{ form_widget(entry.label, {attr: {class: 'form-control form-control-sm', placeholder: package ? 'vendor/package' : ''}}) }}{{ form_errors(entry.label) }}
            {% endif %}
            {% if package %}
                {{ form_widget(entry.package) }}
                {{ form_widget(entry.packageType) }}
            {% endif %}
            {% if changed %}
                {# Bootstrap's form theme draws it as a switch with its label #}
                <div class="upgrade-reviewed small mt-1">{{ form_row(entry.reviewed, {attr: {role: 'switch'}, label_attr: {class: 'checkbox-switch'}, row_attr: {class: 'mb-0'}}) }}</div>
            {% else %}
                {# nothing to check: not rendered at all, or form_end() would add it below the form #}
                {% do entry.reviewed.setRendered %}
            {% endif %}
        </td>
        {% if package %}
            <td class="upgrade-col-version">{{ form_widget(entry.installedVersion, sm) }}</td>
            <td class="upgrade-col-version upgrade-col-target">{{ form_widget(entry.targetVersion, sm) }}</td>
            <td class="upgrade-col-status">{{ form_widget(entry.status, {attr: {class: 'form-select form-select-sm'}}) }}</td>
        {% endif %}
        {% if sumOf %}
            {% for bound in ['min', 'max'] %}
                <td class="upgrade-col-hours">{{ form_widget(entry[bound ~ 'Hours'], {attr: {class: 'form-control-plaintext form-control-sm', readonly: 'readonly', tabindex: '-1', 'data-upgrade-sums-target': 'sum', 'data-sum-of': sumOf, 'data-bound': bound, 'aria-label': ('calculation.' ~ bound ~ '_hours_of')|trans({label: enum('App\\Entity\\UpgradeSection').from(sumOf)|trans})}}) }}</td>
            {% endfor %}
        {% else %}
            <td class="upgrade-col-hours">{{ form_widget(entry.minHours, sm) }}{{ form_errors(entry.minHours) }}</td>
            <td class="upgrade-col-hours">{{ form_widget(entry.maxHours, sm) }}{{ form_errors(entry.maxHours) }}
                {%- if previous and (previous.minHours is not same as(entry.minHours.vars.data) or previous.maxHours is not same as(entry.maxHours.vars.data)) %}
                    <small class="text-muted d-block upgrade-previous-hours">{% set range = [previous.minHours, previous.maxHours]|filter(h => h is not null)|map(h => h|format_number)|reduce((list, h) => h in list ? list : list|merge([h]), []) %}
                    {{- 'calculation.previous_hours'|trans({hours: range is empty ? '–' : range|join('–')}) }}</small>
                {%- endif %}</td>
        {% endif %}
        <td class="upgrade-col-notes" data-note-editor-target="cell">
            {{ form_widget(entry.notes, {attr: {'data-note-field': 'text'}}) }}
            {{ form_widget(entry.noteLevel, {attr: {class: 'd-none', 'data-note-field': 'level', 'aria-hidden': 'true', tabindex: '-1'}}) }}
            {{ _self.note_preview(entry.notes.vars.value, entry.noteLevel.vars.value) }}
            {% if previous and previous.notes %}
                {# shown in the note dialog, to merge the notes of the previous version #}
                <template data-note-field="previous" data-level="{{ previous.noteLevel.value ?? '' }}">
                    <div class="upgrade-previous-note{{ previous.noteLevel ? ' upgrade-note-' ~ previous.noteLevel.value }}">{{ previous.notes|markdown_to_html }}</div>
                    <textarea>{{ previous.notes }}</textarea>
                </template>
            {% endif %}
        </td>
        <td class="upgrade-col-text">{{ form_widget(entry.assignee, sm) }}</td>
        <td class="upgrade-col-actions">
            {% if not sumOf %}
                <button type="button" class="btn btn-sm btn-outline-neutral" data-action="form-collection#remove" aria-label="{{ 'calculation.remove_row'|trans }}">{{ icon('trash') }}</button>
            {% endif %}
        </td>
    </tr>
{% endmacro %}

{# What the support phases mean for the upgrade, in words #}
{% macro support_text(cms, phases, fromMajor) %}
    {% for phase in phases %}
        <p class="mb-1">
            {{ 'calculation.support.free'|trans({cms: cms ~ ' ' ~ phase.major, until: phase.maintainedUntil|format_date(pattern: 'MMMM y')}) }}
            {% if phase.extendedUntil and phase.major == fromMajor %}
                {{ 'calculation.support.elts'|trans({from: phase.maintainedUntil|date_modify('+1 day')|format_date(pattern: 'MMMM y'), until: phase.extendedUntil|format_date(pattern: 'MMMM y')}) }}
            {% endif %}
        </p>
    {% endfor %}
{% endmacro %}

{# Bars of the support phases on a time axis (geometry from UpgradeSupportChart), like the roadmap of typo3.com #}
{% macro support_chart(cms, chart) %}
    {% set titles = {development: 'calculation.phase.development'|trans, regular: 'calculation.phase.regular'|trans, priority: 'calculation.phase.priority'|trans, extended: 'calculation.phase.extended'|trans} %}
    <svg class="upgrade-roadmap" viewBox="0 0 {{ constant('App\\Dto\\UpgradeSupportChart::WIDTH') }} {{ chart.height }}" role="img" aria-label="{{ 'calculation.phase.label'|trans({cms: cms ~ ' ' ~ chart.rows|map(r => r.major)|join(', ')}) }}">
        {% for year in chart.years %}
            <line class="upgrade-roadmap-grid" x1="{{ year.x }}" x2="{{ year.x }}" y1="0" y2="{{ chart.height - 20 }}"/>
            <text class="upgrade-roadmap-year" x="{{ year.x }}" y="{{ chart.height - 4 }}" text-anchor="middle">{{ year.year }}</text>
        {% endfor %}
        {% for row in chart.rows %}
            <text class="upgrade-roadmap-label" x="0" y="{{ row.y + 15 }}">{{ cms }} {{ row.major }}</text>
            {% for segment in row.segments %}
                <rect class="upgrade-roadmap-{{ segment.phase }}" x="{{ segment.x }}" y="{{ row.y }}" width="{{ segment.width }}" height="20"><title>{{ 'calculation.phase.until'|trans({phase: titles[segment.phase], until: segment.until|format_date('medium')}) }}</title></rect>
            {% endfor %}
            {% for tick in row.ticks %}
                <line class="upgrade-roadmap-tick" x1="{{ tick }}" x2="{{ tick }}" y1="{{ row.y + 3 }}" y2="{{ row.y + 17 }}"/>
            {% endfor %}
        {% endfor %}
        {% if chart.today is not null %}
            <line class="upgrade-roadmap-today" x1="{{ chart.today }}" x2="{{ chart.today }}" y1="0" y2="{{ chart.height - 20 }}"/>
        {% endif %}
    </svg>
    <p class="small text-muted mb-0 d-flex flex-wrap column-gap-3">
        {% for phase, title in titles %}
            <span><span class="upgrade-roadmap-key upgrade-roadmap-{{ phase }}"></span> {{ title }}</span>
        {% endfor %}
        <span><span class="upgrade-roadmap-key upgrade-roadmap-today-key"></span> {{ 'calculation.today'|trans }}</span>
    </p>
{% endmacro %}
