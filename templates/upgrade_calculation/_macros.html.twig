{% macro hours(range) -%}
    {{ range.min == range.max ? range.min|number_format(2) : range.min|number_format(2) ~ '–' ~ range.max|number_format(2) }} h
{%- endmacro %}

{% macro price(range, rate) -%}
    {{ (range.min * rate) == (range.max * rate) ? (range.min * rate)|number_format(2, ',', '.') : (range.min * rate)|number_format(2, ',', '.') ~ ' – ' ~ (range.max * rate)|number_format(2, ',', '.') }} EUR
{%- endmacro %}

{# One editable row of a calculation form; also renders the prototype for new rows #}
{% macro form_row(entry, package) %}
    {% set sm = {attr: {class: 'form-control form-control-sm'}} %}
    <tr data-form-collection-row>
        <td class="upgrade-col-handle">
            <button type="button" class="btn btn-sm upgrade-handle" aria-label="Move row: drag, or use the arrow keys"
                    data-action="pointerdown->form-collection#grab keydown->form-collection#key">{{ icon('grip-vertical') }}</button>
            {{ form_widget(entry.position, {attr: {'data-form-collection-target': 'position'}}) }}
        </td>
        <td class="upgrade-col-label">
            {{ form_widget(entry.label, {attr: {class: 'form-control form-control-sm', placeholder: package ? 'vendor/package' : ''}}) }}{{ form_errors(entry.label) }}
            {% if package %}
                {{ form_widget(entry.package) }}
                {{ form_widget(entry.packageType) }}
            {% endif %}
        </td>
        {% if package %}
            <td class="upgrade-col-version">{{ form_widget(entry.installedVersion, sm) }}</td>
            <td class="upgrade-col-version">{{ form_widget(entry.targetVersion, sm) }}</td>
            <td class="upgrade-col-status">{{ form_widget(entry.status, {attr: {class: 'form-select form-select-sm'}}) }}</td>
        {% endif %}
        <td class="upgrade-col-hours">{{ form_widget(entry.minHours, sm) }}{{ form_errors(entry.minHours) }}</td>
        <td class="upgrade-col-hours">{{ form_widget(entry.maxHours, sm) }}{{ form_errors(entry.maxHours) }}</td>
        <td class="upgrade-col-notes">{{ form_widget(entry.notes, sm) }}</td>
        <td class="upgrade-col-text">{{ form_widget(entry.assignee, sm) }}</td>
        <td class="upgrade-col-actions">
            <button type="button" class="btn btn-sm btn-outline-danger" data-action="form-collection#remove" aria-label="Remove row">{{ icon('trash') }}</button>
        </td>
    </tr>
{% endmacro %}
