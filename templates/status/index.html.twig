{% extends 'base.html.twig' %}
{% import 'dashboard/_macros.html.twig' as m %}

{% block title %}{{ 'nav.status'|trans }} - CMS Observer{% endblock %}

{% block page_title %}{{ 'nav.status'|trans }}{% endblock %}

{% block body %}
<div class="container">
    {# like the TYPO3 scheduler module: which time the page shows and when the scheduler last did its job #}
    {% set timezoneMismatch = lastSuccess and lastSuccess.timezone and lastSuccess.timezone != timezone %}
    <div class="alert {{ lastSuccess is null or timezoneMismatch ? 'alert-warning' : 'alert-info' }}">
        <h2 class="h6">Scheduler</h2>
        <p class="mb-2">
            {{ 'status.server_time'|trans({now: 'now'|date('Y-m-d H:i T'), timezone: timezone, offset: 'now'|date('P')}) }}
            {% if timezoneMismatch %}
                {{ 'status.timezone_mismatch'|trans({timezone: '<strong>' ~ lastSuccess.timezone|e ~ '</strong>'})|raw }}
            {% endif %}
        </p>
        <p class="mb-0">
            {% if lastSuccess is null %}
                {{ 'status.never_ran'|trans }}
            {% else %}
                {{ 'status.last_sync'|trans({
                    command: '<code>' ~ lastSuccess.command|e ~ '</code>',
                    how: lastSuccess.lastRunScheduled ? 'scheduled' : (lastSuccess.lastRunScheduled is same as(false) ? 'manual' : 'unknown'),
                    started: lastSuccess.lastStartedAt ? lastSuccess.lastStartedAt|date('Y-m-d') : 'unknown',
                    startedTime: lastSuccess.lastStartedAt ? lastSuccess.lastStartedAt|date('H:i') : '',
                    ended: lastSuccess.lastSucceededAt|date('Y-m-d'),
                    endedTime: lastSuccess.lastSucceededAt|date('H:i'),
                })|raw }}
            {% endif %}
        </p>
    </div>

    <p class="text-muted">
        {{ 'status.intro'|trans }}
    </p>
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sync</th>
                        <th>{{ 'status.schedule'|trans }}</th>
                        <th>{{ 'status.last_success'|trans }}</th>
                        <th>{{ 'status.last_failure'|trans }}</th>
                        <th>{{ 'nav.status'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for sync in syncs %}
                    <tr>
                        <td class="text-nowrap">
                            <code>{{ sync.command }}</code>
                            {% set description = ('sync.' ~ sync.command)|trans %}
                            {% set description = description starts with 'sync.' ? sync.description : description %}
                            {% if description %}
                                <span class="text-muted ms-1" tabindex="0" role="img" aria-label="{{ description }}"
                                      data-controller="tooltip" data-bs-toggle="tooltip" title="{{ description }}">{{ icon('info') }}</span>
                            {% endif %}
                        </td>
                        <td class="text-nowrap"><code>{{ sync.schedule }}</code></td>
                        <td class="text-nowrap">{{ sync.lastSucceededAt ? sync.lastSucceededAt|date('Y-m-d H:i') : 'project.never'|trans }}</td>
                        <td class="text-nowrap">
                            {% if sync.lastFailedAt %}
                                {{ sync.lastFailedAt|date('Y-m-d H:i') }}
                                <span class="text-danger ms-1" tabindex="0" role="img" aria-label="{{ sync.lastError }}"
                                      data-controller="tooltip" data-bs-toggle="tooltip" title="{{ sync.lastError }}">{{ icon('info') }}</span>
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>
                        {% if sync.overdue %}
                            <span class="badge text-bg-danger">{{ m.icon_warning() }}<span class="badge-text">{{ 'status.overdue'|trans }}</span></span>
                        {% else %}
                            <span class="badge text-bg-success">{{ m.icon_check() }}<span class="badge-text">OK</span></span>
                        {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">{{ 'status.no_syncs'|trans }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h2 class="h6">{{ 'status.mail_test'|trans }}</h2>
            <p class="text-muted">
                {{ 'status.mail_test_hint'|trans({from: '<code>' ~ mailFrom|e ~ '</code>', transport: '<code>' ~ mailTransport|e ~ '</code>'})|raw }}
            </p>
            {{ form_start(mailTestForm) }}
                {{ form_row(mailTestForm.recipient) }}
                <button type="submit" class="btn btn-tertiary">{{ 'status.mail_test_send'|trans }}</button>
            {{ form_end(mailTestForm) }}
        </div>
    </div>
</div>
{% endblock %}
