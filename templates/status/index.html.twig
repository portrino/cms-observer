{% extends 'base.html.twig' %}
{% import 'dashboard/_macros.html.twig' as m %}

{% block title %}Status - CMS Observer{% endblock %}

{% block page_title %}Status{% endblock %}

{% block body %}
<div class="container">
    {# like the TYPO3 scheduler module: which time the page shows and when the scheduler last did its job #}
    {% set timezoneMismatch = lastSuccess and lastSuccess.timezone and lastSuccess.timezone != timezone %}
    <div class="alert {{ lastSuccess is null or timezoneMismatch ? 'alert-warning' : 'alert-info' }}">
        <h2 class="h6">Scheduler</h2>
        <p class="mb-2">
            All times are the server's, as the scheduler runs on the server.
            Current server time is {{ 'now'|date('Y-m-d H:i T') }} ({{ timezone }}, GMT {{ 'now'|date('P') }}).
            {% if timezoneMismatch %}
                But the scheduler's worker runs in <strong>{{ lastSuccess.timezone }}</strong>: times it records are off by
                the difference, and syncs may show as overdue. Set the same <code>date.timezone</code> in the PHP
                configuration of the web server and the command line.
            {% endif %}
        </p>
        <p class="mb-0">
            {% if lastSuccess is null %}
                The scheduler hasn't run a sync yet: check the cron job that starts its worker, see the installation docs.
            {% else %}
                The last sync was <code>{{ lastSuccess.command }}</code>,
                started {{ lastSuccess.lastRunScheduled ? '(automatically)' : (lastSuccess.lastRunScheduled is same as(false) ? '(manually)') }}
                {%- if lastSuccess.lastStartedAt %} on {{ lastSuccess.lastStartedAt|date('Y-m-d') }} at {{ lastSuccess.lastStartedAt|date('H:i') }}{% endif %}
                and ended on {{ lastSuccess.lastSucceededAt|date('Y-m-d') }} at {{ lastSuccess.lastSucceededAt|date('H:i') }}.
            {% endif %}
        </p>
    </div>

    <p class="text-muted">
        The scheduled syncs fetch the release and vulnerability data the ratings are based on.
        A sync is overdue when it missed its last three runs.
    </p>
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sync</th>
                        <th>Schedule</th>
                        <th>Last success</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                {% for sync in syncs %}
                    <tr>
                        <td class="text-nowrap">
                            <code>{{ sync.command }}</code>
                            {% if sync.description %}
                                <span class="text-muted ms-1" tabindex="0" role="img" aria-label="{{ sync.description }}"
                                      data-controller="tooltip" data-bs-toggle="tooltip" title="{{ sync.description }}">{{ icon('info') }}</span>
                            {% endif %}
                        </td>
                        <td class="text-nowrap"><code>{{ sync.schedule }}</code></td>
                        <td class="text-nowrap">{{ sync.lastSucceededAt ? sync.lastSucceededAt|date('Y-m-d H:i') : 'never' }}</td>
                        <td>
                        {% if sync.overdue %}
                            <span class="badge text-bg-danger">{{ m.icon_warning() }}<span class="badge-text">Overdue</span></span>
                        {% else %}
                            <span class="badge text-bg-success">{{ m.icon_check() }}<span class="badge-text">OK</span></span>
                        {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">No scheduled syncs.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h2 class="h6">Test mail setup</h2>
            <p class="text-muted">
                Sends a test mail from <code>{{ mailFrom }}</code> via <code>{{ mailTransport }}</code>.
            </p>
            {{ form_start(mailTestForm) }}
                {{ form_row(mailTestForm.recipient) }}
                <button type="submit" class="btn btn-tertiary">Send test mail</button>
            {{ form_end(mailTestForm) }}
        </div>
    </div>
</div>
{% endblock %}
