<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo.svg') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    {% set loggedIn = is_granted('ROLE_USER') %}
    <body {% if loggedIn %}data-controller="sidebar"{% endif %}>
        {% if loggedIn %}
            {% set currentRoute = app.request.attributes.get('_route') %}
            <aside class="sidebar">
                {# easter egg like TYPO3's system information; fixed strategy as for the user menu #}
                <div class="sidebar-brand dropdown">
                    <a class="sidebar-brand-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="{{ 'system_info.title'|trans }}">
                        <span class="sidebar-brand-logo">
                            <img src="{{ asset('images/logo.svg') }}" alt="" width="32" height="32">
                            {% set observerUpdate = observer_update() %}
                            {% if observerUpdate %}
                                <b class="sidebar-brand-dot"><span class="visually-hidden">{{ 'system_info.update_available'|trans({version: observerUpdate.version}) }}</span></b>
                            {% endif %}
                        </span>
                        <span class="sidebar-brand-name">CMS Observer</span>
                    </a>
                    <div class="dropdown-menu system-info">
                        <turbo-frame id="system-info" src="{{ path('app_status_system_info') }}" loading="lazy">
                            <div class="text-center p-3"><span class="spinner-border spinner-border-sm text-secondary" role="status"></span></div>
                        </turbo-frame>
                    </div>
                </div>
                <nav class="nav flex-column flex-nowrap py-2 sidebar-nav">
                    <a class="nav-link {{ currentRoute starts with 'dashboard_site' or currentRoute == 'dashboard_index' ? 'active' }}" href="{{ path('dashboard_index') }}">
                        {{ icon('layout-dashboard') }}
                        <span>{{ 'nav.projects'|trans }}</span>
                    </a>
                    <a class="nav-link {{ currentRoute == 'dashboard_packages' ? 'active' }}" href="{{ path('dashboard_packages') }}">
                        {{ icon('package') }}
                        <span>{{ 'nav.packages'|trans }}</span>
                    </a>
                    <a class="nav-link {{ currentRoute starts with 'dashboard_organization' ? 'active' }}" href="{{ path('dashboard_organization_index') }}">
                        {{ icon('building') }}
                        <span>{{ 'nav.organizations'|trans }}</span>
                    </a>
                </nav>
                {% set overdueSyncs = overdue_sync_count() %}
                <nav class="nav flex-column flex-nowrap sidebar-status">
                    <a class="nav-link {{ currentRoute == 'app_status' ? 'active' }}" href="{{ path('app_status') }}"
                       {% if overdueSyncs %}title="{{ 'nav.syncs_overdue'|trans({count: overdueSyncs}) }}"{% endif %}>
                        {{ icon('activity') }}
                        <span>{{ 'nav.status'|trans }}</span>
                        {% if overdueSyncs %}
                            <b class="sidebar-badge badge rounded-pill text-bg-danger">{{ overdueSyncs }}</b>
                        {% endif %}
                    </a>
                </nav>
                {# fixed strategy: the menu opens upwards and, in the collapsed sidebar, beyond its right edge #}
                <div class="sidebar-user dropup">
                    <a class="sidebar-user-toggle dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="{{ 'nav.user_menu'|trans }}">
                        <span class="avatar">{{ app.user.initials }}</span>
                        <span class="sidebar-user-name">{{ app.user.name }}</span>
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_profile') }}">{{ icon('user') }} {{ 'nav.profile'|trans }}</a></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_settings') }}">{{ icon('settings') }} {{ 'nav.settings'|trans }}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2" href="{{ path('app_logout') }}" data-turbo-prefetch="false">{{ icon('log-out') }} {{ 'nav.logout'|trans }}</a></li>
                    </ul>
                </div>
            </aside>
            <div class="sidebar-backdrop" data-action="click->sidebar#close"></div>
            <header class="app-topbar">
                <button type="button" class="btn btn-sm sidebar-toggle" data-action="sidebar#toggle" aria-label="{{ 'nav.toggle_sidebar'|trans }}">
                    {{ icon('panel-left-close', 'icon sidebar-icon-close') }}
                    {{ icon('panel-left-open', 'icon sidebar-icon-open') }}
                </button>
                {# pages put their title and actions here, so the actions stay in view while scrolling #}
                <h1 class="topbar-title">{% block page_title %}{% endblock %}</h1>
                <div class="topbar-actions">{% block page_actions %}{% endblock %}</div>
            </header>
            <main class="app-main">
        {% else %}
            <div class="container">
        {% endif %}

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message|trans }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger">{{ message|trans }}</div>
                {% endfor %}
                {% block body %}{% endblock %}

        {% if loggedIn %}
            </main>
        {% else %}
            </div>
        {% endif %}
    </body>
</html>
