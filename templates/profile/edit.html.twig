{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.title'|trans }} - CMS Observer{% endblock %}

{% block page_title %}{{ 'profile.title'|trans }}{% endblock %}

{% block body %}
<div class="container" style="max-width: 500px;">
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.email) }}
                {{ form_row(form.plainPassword) }}
                {{ form_row(form.currentPassword) }}
                <button type="submit" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('save') }} {{ 'common.save'|trans }}</button>
            {{ form_end(form) }}
        </div>
    </div>

    <h2 class="h4 mt-4 mb-3">{{ 'two_factor.title'|trans }}</h2>
    <div class="card">
        <div class="card-body">
            {% if app.user.totpAuthenticationEnabled %}
                <p>
                    <span class="badge text-bg-success">{{ 'profile.2fa.enabled'|trans }}</span>
                    {% if app.user.twoFactorEnabledAt %}<span class="text-muted ms-1">{{ 'profile.2fa.since'|trans({date: app.user.twoFactorEnabledAt|format_date('medium')}) }}</span>{% endif %}
                </p>
                <p>
                    {{ 'profile.2fa.codes_left'|trans({count: app.user.remainingBackupCodeCount}) }}
                    {% if app.user.remainingBackupCodeCount < 3 %}<strong>{{ 'profile.2fa.codes_soon'|trans }}</strong>{% endif %}
                </p>
                <a href="{{ path('app_2fa_regenerate_backup_codes') }}" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">{{ icon('key-round') }} {{ 'profile.2fa.new_codes'|trans }}</a>
                <a href="{{ path('app_2fa_disable') }}" class="btn btn-outline-danger d-inline-flex align-items-center gap-1 ms-2">{{ icon('shield-off') }} {{ 'profile.2fa.disable'|trans }}</a>
            {% elseif not twoFactorAvailable %}
                <p class="mb-0 text-muted">{{ 'profile.2fa.unavailable'|trans|raw }}</p>
            {% else %}
                <p>{{ 'profile.2fa.intro'|trans }}</p>
                <a href="{{ path('app_2fa_enable') }}" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('shield-check') }} {{ 'profile.2fa.setup'|trans }}</a>
            {% endif %}
        </div>
    </div>

    <h2 class="h4 mt-4 mb-3">{{ 'profile.language'|trans }}</h2>
    <div class="card">
        <div class="card-body">
            {{ form_start(languageForm, {attr: {id: 'language-form'}}) }}
                {{ form_row(languageForm.locale) }}
                <button type="submit" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('save') }} {{ 'common.save'|trans }}</button>
            {{ form_end(languageForm) }}
        </div>
    </div>
</div>
{% endblock %}
