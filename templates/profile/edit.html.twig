{% extends 'base.html.twig' %}

{% block title %}My Profile - CMS Observer{% endblock %}

{% block page_title %}My Profile{% endblock %}

{% block body %}
<div class="container" style="max-width: 500px;">
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.email) }}
                {{ form_row(form.plainPassword) }}
                {{ form_row(form.currentPassword) }}
                <button type="submit" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('save') }} Save</button>
            {{ form_end(form) }}
        </div>
    </div>

    <h2 class="h4 mt-4 mb-3">Two-factor authentication</h2>
    <div class="card">
        <div class="card-body">
            {% if app.user.totpAuthenticationEnabled %}
                <p>
                    <span class="badge text-bg-success">Enabled</span>
                    {% if app.user.twoFactorEnabledAt %}<span class="text-muted ms-1">since {{ app.user.twoFactorEnabledAt|date('Y-m-d') }}</span>{% endif %}
                </p>
                <p>
                    {{ app.user.remainingBackupCodeCount }} unused backup code{{ app.user.remainingBackupCodeCount == 1 ? '' : 's' }} left.
                    {% if app.user.remainingBackupCodeCount < 3 %}<strong>Generate new ones soon.</strong>{% endif %}
                </p>
                <a href="{{ path('app_2fa_regenerate_backup_codes') }}" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">{{ icon('key-round') }} New backup codes</a>
                <a href="{{ path('app_2fa_disable') }}" class="btn btn-outline-danger d-inline-flex align-items-center gap-1 ms-2">{{ icon('shield-off') }} Disable</a>
            {% elseif not twoFactorAvailable %}
                <p class="mb-0 text-muted">Two-factor authentication isn't available yet: the server has no valid <code>TOTP_ENCRYPTION_KEY</code> configured. Please contact the administrator.</p>
            {% else %}
                <p>Protect your account with a code from an authenticator app in addition to your password.</p>
                <a href="{{ path('app_2fa_enable') }}" class="btn btn-tertiary d-inline-flex align-items-center gap-1">{{ icon('shield-check') }} Set up two-factor authentication</a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
