{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.codes.title'|trans }} - CMS Observer{% endblock %}

{% block page_title %}{{ 'profile.codes.yours'|trans }}{% endblock %}

{% block body %}
<div class="container" style="max-width: 500px;">
    <div class="card">
        <div class="card-body">
            <div class="alert alert-warning">
                {{ 'profile.codes.warning'|trans|raw }}
            </div>
            <ul class="list-unstyled row row-cols-2 font-monospace fs-6 mb-3" id="backup-codes">
                {% for code in backupCodes %}
                    <li class="col mb-1 user-select-all">{{ code }}</li>
                {% endfor %}
            </ul>
            <a href="{{ path('app_profile') }}" class="btn btn-tertiary">{{ 'profile.codes.saved'|trans }}</a>
        </div>
    </div>
</div>
{% endblock %}
